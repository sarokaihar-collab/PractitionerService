root = true

# =========================================================
# Defaults for all files
# =========================================================
[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Config files use 2-space indent
[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

# =========================================================
# C# files
# =========================================================
[*.cs]

dotnet_code_quality.CA1062.null_check_validation_methods = Validate

# --- Code style & formatting ---
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# var usage
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Null checks
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning

# Braces
csharp_prefer_braces = true:warning

# --- Naming ---
# Private fields: _camelCase (SA1309 is disabled below to allow this)
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = _camelCase
dotnet_naming_rule.private_fields.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style._camelCase.required_prefix = _
dotnet_naming_style._camelCase.capitalization = camel_case

# =========================================================
# Critical rules (error) — must fail the build
# =========================================================
# EF Core: internal APIs break on upgrade
dotnet_diagnostic.EF1001.severity = error
# EF Core: interpolated strings in FromSqlRaw / ExecuteSqlRaw (SQL injection risk)
dotnet_diagnostic.EF1002.severity = error
# SQL injection in raw queries
dotnet_diagnostic.CA2100.severity = error
# async void — crashes the process instead of returning the exception
dotnet_diagnostic.VSTHRD100.severity = error

# =========================================================
# Important rules (warning)
# =========================================================
# Resource management (Dispose)
dotnet_diagnostic.CA1001.severity = warning  # Disposable fields → disposable type
dotnet_diagnostic.CA1063.severity = warning  # Implement IDisposable correctly
dotnet_diagnostic.CA1816.severity = warning  # Call GC.SuppressFinalize correctly
dotnet_diagnostic.CA2000.severity = warning  # Dispose before losing scope
dotnet_diagnostic.CA2213.severity = warning  # Disposable fields must be disposed

# Async & performance
dotnet_diagnostic.CA2007.severity = warning  # ConfigureAwait in library code
dotnet_diagnostic.MA0004.severity = warning  # ConfigureAwait(false) in libraries
dotnet_diagnostic.RCS1090.severity = warning # Add ConfigureAwait
dotnet_diagnostic.CA1849.severity = warning  # Use CancellationToken where possible
dotnet_diagnostic.CA2016.severity = warning  # Pass CancellationToken to async methods
dotnet_diagnostic.CA2214.severity = warning  # Do not call virtual methods in constructors

# String handling & globalization
dotnet_diagnostic.MA0006.severity = warning # string.Equals with StringComparison
dotnet_diagnostic.CA1305.severity = warning # Provide IFormatProvider
dotnet_diagnostic.CA1307.severity = warning # Provide StringComparison

# Correctness & security
dotnet_diagnostic.CA1062.severity = warning # Validate arguments of public methods
dotnet_diagnostic.CA2200.severity = warning # Do not use "throw ex;" — preserves stack trace
dotnet_diagnostic.CA2202.severity = warning # Do not dispose objects multiple times
dotnet_diagnostic.CA2111.severity = warning # Pointers should not be visible
dotnet_diagnostic.CA2101.severity = warning # Specify marshaling for P/Invoke string arguments
dotnet_diagnostic.CA1065.severity = warning # Do not raise exceptions in unexpected locations
dotnet_diagnostic.CA1033.severity = warning # Interface methods should be callable by child types

# StyleCop — critical only
dotnet_diagnostic.SA1200.severity = warning # Using directives must be ordered correctly

# Sonar — a couple of high-value rules
dotnet_diagnostic.S3776.severity = warning  # Cognitive complexity threshold
dotnet_diagnostic.S3649.severity = warning  # Regex must not be vulnerable to ReDoS

# =========================================================
# Suggestions (low noise)
# =========================================================
dotnet_diagnostic.CA1822.severity = suggestion # Member can be static
dotnet_diagnostic.CA1016.severity = suggestion # Mark assemblies with AssemblyVersion
dotnet_diagnostic.CA1821.severity = suggestion # Remove empty finalizers
dotnet_diagnostic.CA2207.severity = suggestion # Initialize static fields inline

# =========================================================
# Disabled rules
# =========================================================
# StyleCop rules disabled in the original .ruleset (kept off)
dotnet_diagnostic.SA1101.severity = none # "this." prefix on member access
dotnet_diagnostic.SA1309.severity = none # Field names should not begin with underscore (we use _camelCase)
dotnet_diagnostic.SA1310.severity = none # Field names should not contain underscores
dotnet_diagnostic.SA1404.severity = suggestion # Suppressions must have a justification

# StyleCop documentation rules — off by default; we only write XML docs where they matter (Api layer / Swagger)
dotnet_diagnostic.SA1600.severity = none # Elements must be documented
dotnet_diagnostic.SA1601.severity = none # Partial elements must be documented
dotnet_diagnostic.SA1602.severity = none # Enumeration items must be documented
dotnet_diagnostic.SA1604.severity = none # Element parameters must be documented
dotnet_diagnostic.SA1605.severity = none # Partial element parameter docs
dotnet_diagnostic.SA1606.severity = none # Element return value must be documented
dotnet_diagnostic.SA1607.severity = none # Generic type parameters must be documented
dotnet_diagnostic.SA1608.severity = none # Undocumented element
dotnet_diagnostic.SA1610.severity = none # Property documentation
dotnet_diagnostic.SA1611.severity = none # Parameter documentation
dotnet_diagnostic.SA1612.severity = none # Parameter type documentation
dotnet_diagnostic.SA1613.severity = none # Type parameter documentation
dotnet_diagnostic.SA1614.severity = none # Parameter description in XML
dotnet_diagnostic.SA1615.severity = none # Return value documentation
dotnet_diagnostic.SA1616.severity = none # Include element documentation
dotnet_diagnostic.SA1617.severity = none # Inheritdoc element documentation
dotnet_diagnostic.SA1618.severity = none # Generic type parameter documentation
dotnet_diagnostic.SA1619.severity = none # Documentation for operators
dotnet_diagnostic.SA1620.severity = none # Documentation for conversions
dotnet_diagnostic.SA1621.severity = none # Documentation for indexers
dotnet_diagnostic.SA1622.severity = none # Documentation for file-level elements
dotnet_diagnostic.SA1623.severity = none # Property summary must be in <summary>
dotnet_diagnostic.SA1624.severity = none # Property summary must end with a period
dotnet_diagnostic.SA1625.severity = none # Parameter documentation order
dotnet_diagnostic.SA1626.severity = none # Comments inside documentation tags
dotnet_diagnostic.SA1627.severity = none # Documentation separators
dotnet_diagnostic.SA1633.severity = none # File header required
dotnet_diagnostic.SA1634.severity = none # File header must include company name
dotnet_diagnostic.SA1635.severity = none # File header must include copyright
dotnet_diagnostic.SA1636.severity = none # File header must have valid copyright text
dotnet_diagnostic.SA1637.severity = none # File header must include filename
dotnet_diagnostic.SA1638.severity = none # File header must have valid pattern
dotnet_diagnostic.SA1640.severity = none # File header must have valid copyright text
dotnet_diagnostic.SA1641.severity = none # File header must have valid company attribute
dotnet_diagnostic.SA1642.severity = none # Constructor summary should be "Initializes a new instance"
dotnet_diagnostic.SA1643.severity = none # Constructor summary documentation for generic types
dotnet_diagnostic.SA1648.severity = none # Inheritdoc must not be used for overrides
dotnet_diagnostic.SA1649.severity = none # File name must match type name (relaxed)
dotnet_diagnostic.SA1651.severity = none # Legacy documentation rules
dotnet_diagnostic.SA1652.severity = none # Use <inheritdoc> correctly
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
dotnet_diagnostic.RCS1194.severity = none

# =========================================================
# Removed rules from the original .ruleset
# =========================================================
# The following rules no longer exist on .NET 5+ and are therefore ignored:
#   CA2122, CA2123, CA2124, CA2126, CA2131, CA2132, CA2133, CA2134, CA2137, CA2138,
#   CA2140, CA2141, CA2146, CA2147, CA2149   — CAS (Code Access Security) removed
#   CA2108, CA2112, CA2114, CA2116, CA2117   — declarative security / APTCA
#   CA2220, CA2229, CA2232, CA2235, CA2236, CA2237, CA2238 — legacy serialization
#   CA2240, CA2241, CA2242                   — compiler/analyzer covers these now
#   CA1400, CA1401, CA1403, CA1404, CA1405, CA1410, CA1415 — COM interop (desktop only)
#   CA1049, CA1060, CA1061, CA1301, CA1900, CA1901, CA2212, CA2216 — desktop / legacy
#   CC0001, CC0105, CC0063                   — CodeCracker.CSharp (unmaintained since 2018)
#   CS1591                                   — covered by GenerateDocumentationFile + NoWarn in Api.csproj