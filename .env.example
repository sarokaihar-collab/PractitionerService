# Хост-порты для docker-compose.
# Скопируйте в .env и поменяйте при конфликтах с другими сервисами на машине.

# PostgreSQL host port (default 5432, often busy with a local Postgres)
POSTGRES_HOST_PORT=5434

# Redis host port (default 6379, often busy with another Redis)
REDIS_HOST_PORT=6380

# API host port
API_HOST_PORT=8081

# === PostgreSQL credentials ===
# These are LOCAL DEVELOPMENT credentials for the docker-compose Postgres.
# DO NOT reuse them in production. In production, use a secrets manager
# (Azure Key Vault / AWS Secrets Manager / HashiCorp Vault) or platform
# secrets (Kubernetes Secrets, GitHub Actions Secrets).
POSTGRES_DB=practitioners
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres