# Хост-порты для docker-compose.
# Скопируйте в .env и поменяйте при конфликтах с другими сервисами на машине.

# Внешний порт PostgreSQL (по умолчанию 5432, часто занят локальным Postgres)
POSTGRES_HOST_PORT=5434

# Внешний порт Redis (по умолчанию 6379, часто занят другим Redis)
REDIS_HOST_PORT=6380

# Внешний порт API
API_HOST_PORT=8081